def Fq.from_array.s0(+k: U32, p: Array<U32> & U32) -> Array<U32> & Fq:
  (a, +v0) = p
  Fq.from_array.s1(k, v0, a[(k + 1 : U32)])

def Fq.from_array(a: Array<U32>, i: Nat) -> Array<U32> & Fq:
  +k = U32.from_nat((i * 16n))
  Fq.from_array.s0(k, a[k])

# store x as element i (16 words at 16*i)
def Fq.to_array(a: Array<U32>, i: Nat, x: Fq) -> Array<U32>:
  match x:
    case Fq{l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15}:
      +k = U32.from_nat((i * 16n))
      a[k] <- l0
      a[(k + 1 : U32)] <- l1
      a[(k + 2 : U32)] <- l2
      a[(k + 3 : U32)] <- l3
      a[(k + 4 : U32)] <- l4
      a[(k + 5 : U32)] <- l5
      a[(k + 6 : U32)] <- l6
      a[(k + 7 : U32)] <- l7
      a[(k + 8 : U32)] <- l8
      a[(k + 9 : U32)] <- l9
      a[(k + 10 : U32)] <- l10
      a[(k + 11 : U32)] <- l11
      a[(k + 12 : U32)] <- l12
      a[(k + 13 : U32)] <- l13
      a[(k + 14 : U32)] <- l14
      a[(k + 15 : U32)] <- l15
      a

# limb 0 (x mod 2^16); handy for checksums
def Fq.lo(x: Fq) -> U32:
  match x:
    case Fq{l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15}:
      l0

# drop limb 0, shift the rest down, top limb becomes 0
def Fq.shift_down(x: Fq) -> Fq:
  match x:
    case Fq{l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15}:
      Fq{l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15, 0}

# limb j of x (0 for j >= 16)
def Fq.limb(j: Nat, x: Fq) -> U32:
  match j:
    case 0n:
      Fq.lo(x)
    case 1n+p:
      Fq.limb(p, Fq.shift_down(x))

# bits lo..lo+width-1 of a CANONICAL (non-Montgomery) x as a U32; width <= 16
def Fq.bits_window(+x: Fq, +lo: Nat, width: Nat) -> U32:
  +q = (lo / 16n)
  +r = (lo % 16n)
  +wlo = U32.shrn(Fq.limb(q, x), r)
  +whi = U32.shln(Fq.limb((q + 1n), x), Nat.sub(16n, r))
  U32.and(U32.or(wlo, whi), U32.sub(U32.shln(1, width), 1))

def Fq.hexc(+n: U32) -> Char:
  Chr{U32.add(U32.add(n, 48), U32.mul(39, U32.shrn(U32.add(n, 6), 4n)))}

def Fq.hex4(+v: U32) -> String:
  SCon{Fq.hexc(U32.and(U32.shrn(v, 12n), 15)), SCon{Fq.hexc(U32.and(U32.shrn(v, 8n), 15)), SCon{Fq.hexc(U32.and(U32.shrn(v, 4n), 15)), SCon{Fq.hexc(U32.and(v, 15)), SNil{}}}}}

# 0x + 64 big-endian hex digits of the raw integer record x (call on Fq.to_canonical(x))
def Fq.show_raw(x: Fq) -> String:
  match x:
    case Fq{l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15}:
      "0x" ++ Fq.hex4(l15) ++ Fq.hex4(l14) ++ Fq.hex4(l13) ++ Fq.hex4(l12) ++ Fq.hex4(l11) ++ Fq.hex4(l10) ++ Fq.hex4(l9) ++ Fq.hex4(l8) ++ Fq.hex4(l7) ++ Fq.hex4(l6) ++ Fq.hex4(l5) ++ Fq.hex4(l4) ++ Fq.hex4(l3) ++ Fq.hex4(l2) ++ Fq.hex4(l1) ++ Fq.hex4(l0)

# canonical big-endian 0x hex of a Montgomery-form x
def Fq.show(x: Fq) -> String:
  Fq.show_raw(Fq.to_canonical(x))
