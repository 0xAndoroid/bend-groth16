      +v1924 = U32.sub(v1923, 1)
      +v1925 = U32.or(U32.and(v1827, v1924), U32.and(v1876, U32.not(v1924)))
      +v1926 = U32.or(U32.and(v1830, v1924), U32.and(v1879, U32.not(v1924)))
