# 1 when x == 0 else 0 (branch-free)
def Fq.is_zero(x: Fq) -> U32:
  match x:
    case Fq{l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15}:
      +o = U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(l0, l1), l2), l3), l4), l5), l6), l7), l8), l9), l10), l11), l12), l13), l14), l15)
      U32.sub(1, U32.shrn(U32.or(o, U32.sub(0, o)), 31n))

def Fq.eq(a: Fq, b: Fq) -> U32:
  match a b:
    case Fq{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15} Fq{b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15}:
      +o = U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.xor(a0, b0), U32.xor(a1, b1)), U32.xor(a2, b2)), U32.xor(a3, b3)), U32.xor(a4, b4)), U32.xor(a5, b5)), U32.xor(a6, b6)), U32.xor(a7, b7)), U32.xor(a8, b8)), U32.xor(a9, b9)), U32.xor(a10, b10)), U32.xor(a11, b11)), U32.xor(a12, b12)), U32.xor(a13, b13)), U32.xor(a14, b14)), U32.xor(a15, b15))
      U32.sub(1, U32.shrn(U32.or(o, U32.sub(0, o)), 31n))

# raw integer record -> Montgomery form (x * R^2 * R^-1 = x*R)
def Fq.from_canonical(x: Fq) -> Fq:
  Fq.mul(x, Fq.r2())

# Montgomery form -> raw integer record (x*R * 1 * R^-1 = x)
def Fq.to_canonical(x: Fq) -> Fq:
  Fq.mul(x, Fq.raw_one())

# load element i (16 words at 16*i); stage defs open the (array, word) pairs
def Fq.from_array.s15(+k: U32, +v0: U32, +v1: U32, +v2: U32, +v3: U32, +v4: U32, +v5: U32, +v6: U32, +v7: U32, +v8: U32, +v9: U32, +v10: U32, +v11: U32, +v12: U32, +v13: U32, +v14: U32, p: Array<U32> & U32) -> Array<U32> & Fq:
  (a, +v15) = p
  (a, Fq{v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15})

def Fq.from_array.s14(+k: U32, +v0: U32, +v1: U32, +v2: U32, +v3: U32, +v4: U32, +v5: U32, +v6: U32, +v7: U32, +v8: U32, +v9: U32, +v10: U32, +v11: U32, +v12: U32, +v13: U32, p: Array<U32> & U32) -> Array<U32> & Fq:
  (a, +v14) = p
  Fq.from_array.s15(k, v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, a[(k + 15 : U32)])

def Fq.from_array.s13(+k: U32, +v0: U32, +v1: U32, +v2: U32, +v3: U32, +v4: U32, +v5: U32, +v6: U32, +v7: U32, +v8: U32, +v9: U32, +v10: U32, +v11: U32, +v12: U32, p: Array<U32> & U32) -> Array<U32> & Fq:
  (a, +v13) = p
  Fq.from_array.s14(k, v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, a[(k + 14 : U32)])

