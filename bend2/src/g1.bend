# madd-2007-bl (Jacobian + affine), the MSM hot op
def G1.add_mixed(p: G1, q: G1Aff) -> G1:
  match p q:
    case G1{x1, y1, z1} G1Aff{x2, y2}:
      +z1z1 = Q.Fq.sqr(z1)
      +u2 = Q.Fq.mul(x2, z1z1)
      +s2 = Q.Fq.mul(Q.Fq.mul(y2, z1), z1z1)
