# dbl-2009-l; z = 0 stays z3 = 0
def G1.double(p: G1) -> G1:
  match p:
    case G1{x, y, z}:
      +a = Q.Fq.sqr(x)
      +b = Q.Fq.sqr(y)
      +c = Q.Fq.sqr(b)
      +d0 = Q.Fq.sub(Q.Fq.sub(Q.Fq.sqr(Q.Fq.add(x, b)), a), c)
      +d = Q.Fq.add(d0, d0)
      +e = Q.Fq.add(Q.Fq.add(a, a), a)
      +f = Q.Fq.sqr(e)
      +x3 = Q.Fq.sub(f, Q.Fq.add(d, d))
      +c2 = Q.Fq.add(c, c)
      +c4 = Q.Fq.add(c2, c2)
      +y3 = Q.Fq.sub(Q.Fq.mul(e, Q.Fq.sub(d, x3)), Q.Fq.add(c4, c4))
      +z3 = Q.Fq.mul(Q.Fq.add(y, y), z)
