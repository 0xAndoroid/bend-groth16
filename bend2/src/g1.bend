      +hh2 = Q.Fq.add(hh, hh)
      +i = Q.Fq.add(hh2, hh2)
      +j = Q.Fq.mul(h, i)
      +rr = Q.Fq.sub(s2, y1)
      +r = Q.Fq.add(rr, rr)
      +v = Q.Fq.mul(x1, i)
      +x3 = Q.Fq.sub(Q.Fq.sub(Q.Fq.sqr(r), j), Q.Fq.add(v, v))
      +y1j = Q.Fq.mul(y1, j)
      +y3 = Q.Fq.sub(Q.Fq.mul(r, Q.Fq.sub(v, x3)), Q.Fq.add(y1j, y1j))
      +z3 = Q.Fq.sub(Q.Fq.sub(Q.Fq.sqr(Q.Fq.add(z1, h)), z1z1), hh)
