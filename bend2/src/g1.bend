# add-2007-bl (Jacobian + Jacobian)
def G1.add(p: G1, q: G1) -> G1:
  match p q:
    case G1{x1, y1, z1} G1{x2, y2, z2}:
      +z1z1 = Q.Fq.sqr(z1)
      +z2z2 = Q.Fq.sqr(z2)
      +u1 = Q.Fq.mul(x1, z2z2)
      +u2 = Q.Fq.mul(x2, z1z1)
      +s1 = Q.Fq.mul(Q.Fq.mul(y1, z2), z2z2)
      +s2 = Q.Fq.mul(Q.Fq.mul(y2, z1), z1z1)
      +h = Q.Fq.sub(u2, u1)
      +hh = Q.Fq.add(h, h)
      +i = Q.Fq.sqr(hh)
      +j = Q.Fq.mul(h, i)
      +rr = Q.Fq.sub(s2, s1)
      +r = Q.Fq.add(rr, rr)
      +v = Q.Fq.mul(u1, i)
      +x3 = Q.Fq.sub(Q.Fq.sub(Q.Fq.sqr(r), j), Q.Fq.add(v, v))
      +s1j = Q.Fq.mul(s1, j)
      +y3 = Q.Fq.sub(Q.Fq.mul(r, Q.Fq.sub(v, x3)), Q.Fq.add(s1j, s1j))
      +z3 = Q.Fq.mul(Q.Fq.sub(Q.Fq.sub(Q.Fq.sqr(Q.Fq.add(z1, z2)), z1z1), z2z2), h)
      G1.add.fin(U32.is_eq(Q.Fq.is_zero(z1), 1), U32.is_eq(Q.Fq.is_zero(z2), 1), U32.is_eq(Q.Fq.is_zero(h), 1), U32.is_eq(Q.Fq.is_zero(rr), 1), G1{x1, y1, z1}, G1{x2, y2, z2}, G1{x3, y3, z3})

