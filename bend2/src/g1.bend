  G1Aff.from_array_at.s2(x, Q.Fq.from_array(a, (u + 1n)))

# load the affine point whose x starts at 16-word unit u (word 16*u)
def G1Aff.from_array_at(a: Array<U32>, +u: Nat) -> Array<U32> & G1Aff:
  G1Aff.from_array_at.s1(u, Q.Fq.from_array(a, u))

# load affine point i (32 words at 32*i)
def G1Aff.from_array(a: Array<U32>, i: Nat) -> Array<U32> & G1Aff:
