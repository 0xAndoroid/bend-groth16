    case G1Aff{x, y}:
      Q.Fq.to_array(Q.Fq.to_array(a, (i * 2n), x), ((i * 2n) + 1n), y)

# "x_hex y_hex" (G2: "x0 x1 y0 y1"), canonical
def G1.show_affine(p: G1Aff) -> String:
  match p:
    case G1Aff{x, y}:
      Q.Fq.show(x) ++ " " ++ Q.Fq.show(y)
