            case ALeaf{v}:
              MsmG2St{ANode{p0, p1}, ALeaf{v}, Array.new(U32, bd, 0)}
            case ANode{s0, s1}:
              l r = Msm.g2.tree(e, off, (cap / 2n), n, c, m, wt, bd, p0, s0) Msm.g2.tree(e, (off + (cap / 2n)), (cap / 2n), n, c, m, wt, bd, p1, s1)
              Msm.g2.tree.join((wt * m), l, r)

# running sum from the top bucket: n buckets left ending at unit u; pr = (b, bucket at u)
def Msm.g2.red(n: Nat, +u: Nat, +run: G2.G2, +acc: G2.G2, pr: Array<U32> & G2.G2) -> Array<U32> & G2.G2:
  match n:
    case 0n:
      (b, +q) = pr
      (b, acc)
    case 1n+k:
      (b, +q) = pr
      +run2 = Msm.g2.jadd(run, q)
      Msm.g2.red(k, Nat.sub(u, 8n), run2, Msm.g2.jadd(acc, run2), Msm.g2.bget(b, Nat.sub(u, 8n)))

def Msm.g2.red.fin(pr: Array<U32> & G2.G2) -> G2.G2:
  (b, r) = pr
  r

# sum_{j=1}^{m-1} j * bucket[j] for the window whose buckets fill b
def Msm.g2.window(+m: Nat, b: Array<U32>) -> G2.G2:
  Msm.g2.red.fin(Msm.g2.red(Nat.sub(m, 1n), (Nat.sub(m, 1n) * 8n), G2.G2.infinity(), G2.G2.infinity(), Msm.g2.bget(b, (Nat.sub(m, 1n) * 8n))))

def Msm.g2.dbl(k: Nat, p: G2.G2) -> G2.G2:
  match k:
    case 0n:
      p
    case 1n+j:
      Msm.g2.dbl(j, G2.G2.double(p))

def Msm.g2.wtree.fin(live: Bool, +m: Nat, b: Array<U32>) -> G2.G2:
  match live:
    case True{}:
      Msm.g2.window(m, b)
    case False{}:
      G2.G2.infinity()

# windows w .. w + 2^d - 1 (those >= wt are padding): returns sum_j 2^(c j) S_(w+j)
def Msm.g2.wtree(d: Nat, +w: Nat, +wt: Nat, +c: Nat, +m: Nat, b: Array<U32>) -> G2.G2:
  match d:
    case 0n:
      Msm.g2.wtree.fin(Nat.is_lt(w, wt), m, b)
    case 1n++e:
      match b:
        case ALeaf{v}:
          G2.G2.infinity()
        case ANode{b0, b1}:
          l r = Msm.g2.wtree(e, w, wt, c, m, b0) Msm.g2.wtree(e, (w + Nat.pow(2n, e)), wt, c, m, b1)
          Msm.g2.jadd(l, Msm.g2.dbl((c * Nat.pow(2n, e)), r))

def Msm.g2.fin(+wd: Nat, +wt: Nat, +c: Nat, +m: Nat, st: MsmG2St) -> Array<U32> & (Array<U32> & G2.G2):
  MsmG2St{p, s, b} = st
  (p, (s, Msm.g2.wtree(wd, 0n, wt, c, m, b)))

def Msm.g2.run(+n: Nat, +c: Nat, +fd: Nat, s: Array<U32>, pr: Array<U32> & Nat) -> Array<U32> & (Array<U32> & G2.G2):
  (pts, +words) = pr
  +m = Nat.pow(2n, c)
  +wt = Msm.windows(c)
  +wd = Msm.log2c(wt)
  Msm.g2.fin(wd, wt, c, m, Msm.g2.tree(fd, 0n, (words / 64n), n, c, m, wt, (wd + c + 7n), pts, s))

def Msm.g2.peel_p.fin(p1: Array<U32>, r: Array<U32> & (Array<U32> & G2.G2)) -> Array<U32> & (Array<U32> & G2.G2):
  (p0, rest) = r
  (ANode{p0, p1}, rest)

# the two arrays are split in lockstep, so an oversized points array first sheds its top
# k halves (n fits in what is left); they are stitched back on afterwards
def Msm.g2.peel_p(k: Nat, +n: Nat, +c: Nat, +fd: Nat, pts: Array<U32>, s: Array<U32>) -> Array<U32> & (Array<U32> & G2.G2):
  match k:
    case 0n:
      Msm.g2.run(n, c, fd, s, Msm.size(pts))
    case 1n+j:
      match pts:
        case ALeaf{v}:
          Msm.g2.run(n, c, fd, s, Msm.size(ALeaf{v}))
        case ANode{p0, p1}:
          Msm.g2.peel_p.fin(p1, Msm.g2.peel_p(j, n, c, fd, p0, s))

def Msm.g2.peel_s.fin(s1: Array<U32>, r: Array<U32> & (Array<U32> & G2.G2)) -> Array<U32> & (Array<U32> & G2.G2):
  (p, rest) = r
  (s0, res) = rest
  (p, (ANode{s0, s1}, res))

# same for an oversized scalars array
def Msm.g2.peel_s(k: Nat, +kp: Nat, +n: Nat, +c: Nat, +fd: Nat, pts: Array<U32>, s: Array<U32>) -> Array<U32> & (Array<U32> & G2.G2):
  match k:
    case 0n:
      Msm.g2.peel_p(kp, n, c, fd, pts, s)
    case 1n+j:
      match s:
        case ALeaf{v}:
          Msm.g2.peel_p(kp, n, c, fd, pts, ALeaf{v})
        case ANode{s0, s1}:
          Msm.g2.peel_s.fin(s1, Msm.g2.peel_s(j, kp, n, c, fd, pts, s0))

def Msm.g2.with.s2(+wp: Nat, +n: Nat, +c: Nat, +fd: Nat, pts: Array<U32>, pr: Array<U32> & Nat) -> Array<U32> & (Array<U32> & G2.G2):
  (s, +ws) = pr
  +lp = Msm.log2c((wp / 64n))
  +ls = Msm.log2c((ws / 16n))
  Msm.g2.peel_s(Nat.sub(ls, lp), Nat.sub(lp, ls), n, c, Nat.min(fd, Nat.min(lp, ls)), pts, s)

def Msm.g2.with.s1(s: Array<U32>, +n: Nat, +c: Nat, +fd: Nat, pr: Array<U32> & Nat) -> Array<U32> & (Array<U32> & G2.G2):
  (pts, +wp) = pr
  Msm.g2.with.s2(wp, n, c, fd, pts, Msm.size(s))

# MSM with window size c (8..16) and fork depth fd (2^fd leaves, clamped to the capacity)
def g2_with(points: Array<U32>, scalars: Array<U32>, n: Nat, +c: Nat, +fd: Nat) -> Array<U32> & (Array<U32> & G2.G2):
  Msm.g2.with.s1(scalars, n, c, fd, Msm.size(points))

# sum_i scalars[i] * points[i] over the first n entries; returns (points, (scalars, result))
def g2(points: Array<U32>, scalars: Array<U32>, +n: Nat) -> Array<U32> & (Array<U32> & G2.G2):
  g2_with(points, scalars, n, Msm.pick_c(n), Msm.pick_fd(n, Msm.pick_c(n)))

