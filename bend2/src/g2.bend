                case True{}:
                  G2.double(p)
                case False{}:
                  G2.infinity()

# madd-2007-bl (Jacobian + affine), the MSM hot op
def G2.add_mixed(p: G2, q: G2Aff) -> G2:
  match p q:
    case G2{x1, y1, z1} G2Aff{x2, y2}:
      +z1z1 = Q.Fq2.sqr(z1)
      +u2 = Q.Fq2.mul(x2, z1z1)
      +s2 = Q.Fq2.mul(Q.Fq2.mul(y2, z1), z1z1)
      +h = Q.Fq2.sub(u2, x1)
      +hh = Q.Fq2.sqr(h)
      +hh2 = Q.Fq2.add(hh, hh)
      +i = Q.Fq2.add(hh2, hh2)
      +j = Q.Fq2.mul(h, i)
      +rr = Q.Fq2.sub(s2, y1)
      +r = Q.Fq2.add(rr, rr)
      +v = Q.Fq2.mul(x1, i)
      +x3 = Q.Fq2.sub(Q.Fq2.sub(Q.Fq2.sqr(r), j), Q.Fq2.add(v, v))
      +y1j = Q.Fq2.mul(y1, j)
      +y3 = Q.Fq2.sub(Q.Fq2.mul(r, Q.Fq2.sub(v, x3)), Q.Fq2.add(y1j, y1j))
      +z3 = Q.Fq2.sub(Q.Fq2.sub(Q.Fq2.sqr(Q.Fq2.add(z1, h)), z1z1), hh)
