def G2Aff.from_array_at.s2(+x: Q.Fq2, p: Array<U32> & Q.Fq2) -> Array<U32> & G2Aff:
  (a, +y) = p
  (a, G2Aff{x, y})

def G2Aff.from_array_at.s1(+u: Nat, p: Array<U32> & Q.Fq2) -> Array<U32> & G2Aff:
  (a, +x) = p
  G2Aff.from_array_at.s2(x, Q.Fq2.from_array_at(a, (u + 2n)))

# load the affine point whose x starts at 16-word unit u (word 16*u)
def G2Aff.from_array_at(a: Array<U32>, +u: Nat) -> Array<U32> & G2Aff:
  G2Aff.from_array_at.s1(u, Q.Fq2.from_array_at(a, u))

# load affine point i (64 words at 64*i)
def G2Aff.from_array(a: Array<U32>, i: Nat) -> Array<U32> & G2Aff:
  G2Aff.from_array_at(a, (i * 4n))

# store affine point i (64 words at 64*i)
def G2Aff.to_array(a: Array<U32>, +i: Nat, p: G2Aff) -> Array<U32>:
  match p:
    case G2Aff{x, y}:
      Q.Fq2.to_array(Q.Fq2.to_array(a, (i * 4n), x), ((i * 4n) + 2n), y)

# "x_hex y_hex" (G2: "x0 x1 y0 y1"), canonical
def G2.show_affine(p: G2Aff) -> String:
  match p:
    case G2Aff{x, y}:
      Q.Fq2.show(x) ++ " " ++ Q.Fq2.show(y)
