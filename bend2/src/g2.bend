# BN254 G2 (y^2 = x^3 + b, a = 0) over Q.Fq2. Affine G2Aff{x, y} (infinity = both zero,
# bend2/FORMAT.md); Jacobian G2{x, y, z} (infinity = z zero). Formulas: dbl-2009-l (2M+5S),
# add-2007-bl (11M+5S), madd-2007-bl (7M+4S). Special cases (infinity, P == Q, P == -Q) are
# resolved by a Bool match in the *.fin defs after the generic formula is computed.
import Base
import ./fq2.bend as Q
import ./fr.bend as R

type G2Aff is Data:
  G2Aff{+x: Q.Fq2, +y: Q.Fq2}

type G2 is Data:
  G2{+x: Q.Fq2, +y: Q.Fq2, +z: Q.Fq2}

def G2.infinity() -> G2:
  G2{Q.Fq2.zero(), Q.Fq2.one(), Q.Fq2.zero()}

def G2Aff.infinity() -> G2Aff:
  G2Aff{Q.Fq2.zero(), Q.Fq2.zero()}

def G2Aff.is_inf(p: G2Aff) -> U32:
  match p:
    case G2Aff{x, y}:
      U32.and(Q.Fq2.is_zero(x), Q.Fq2.is_zero(y))

def G2.is_inf(p: G2) -> U32:
  match p:
    case G2{x, y, z}:
      Q.Fq2.is_zero(z)

def G2.from_affine.fin(inf: Bool, p: G2Aff) -> G2:
  match inf:
    case True{}:
      G2.infinity()
    case False{}:
      match p:
        case G2Aff{x, y}:
          G2{x, y, Q.Fq2.one()}

def G2.from_affine(+p: G2Aff) -> G2:
  G2.from_affine.fin(U32.is_eq(G2Aff.is_inf(p), 1), p)

def G2.to_affine.fin(inf: Bool, p: G2) -> G2Aff:
  match inf:
    case True{}:
      G2Aff.infinity()
    case False{}:
      match p:
        case G2{x, y, z}:
          +zi = Q.Fq2.inv(z)
          +zi2 = Q.Fq2.sqr(zi)
          G2Aff{Q.Fq2.mul(x, zi2), Q.Fq2.mul(y, Q.Fq2.mul(zi, zi2))}

# one field inversion
def G2.to_affine(+p: G2) -> G2Aff:
  G2.to_affine.fin(U32.is_eq(G2.is_inf(p), 1), p)

def G2.neg(p: G2) -> G2:
  match p:
    case G2{x, y, z}:
      G2{x, Q.Fq2.neg(y), z}

# neg(0) = 0 keeps the (0, 0) infinity encoding
def G2Aff.neg(p: G2Aff) -> G2Aff:
  match p:
    case G2Aff{x, y}:
      G2Aff{x, Q.Fq2.neg(y)}

def G2.eq_affine(a: G2Aff, b: G2Aff) -> U32:
  match a b:
    case G2Aff{ax, ay} G2Aff{bx, by}:
      U32.and(Q.Fq2.eq(ax, bx), Q.Fq2.eq(ay, by))

# dbl-2009-l; z = 0 stays z3 = 0
def G2.double(p: G2) -> G2:
  match p:
    case G2{x, y, z}:
      +a = Q.Fq2.sqr(x)
      +b = Q.Fq2.sqr(y)
      +c = Q.Fq2.sqr(b)
      +d0 = Q.Fq2.sub(Q.Fq2.sub(Q.Fq2.sqr(Q.Fq2.add(x, b)), a), c)
      +d = Q.Fq2.add(d0, d0)
      +e = Q.Fq2.add(Q.Fq2.add(a, a), a)
      +f = Q.Fq2.sqr(e)
      +x3 = Q.Fq2.sub(f, Q.Fq2.add(d, d))
      +c2 = Q.Fq2.add(c, c)
      +c4 = Q.Fq2.add(c2, c2)
      +y3 = Q.Fq2.sub(Q.Fq2.mul(e, Q.Fq2.sub(d, x3)), Q.Fq2.add(c4, c4))
      +z3 = Q.Fq2.mul(Q.Fq2.add(y, y), z)
      G2{x3, y3, z3}

def G2.add.fin(p_inf: Bool, q_inf: Bool, h_zero: Bool, r_zero: Bool, p: G2, q: G2, gen: G2) -> G2:
  match p_inf:
    case True{}:
      q
    case False{}:
      match q_inf:
        case True{}:
          p
        case False{}:
          match h_zero:
            case False{}:
              gen
            case True{}:
              match r_zero:
                case True{}:
                  G2.double(p)
                case False{}:
                  G2.infinity()

# add-2007-bl (Jacobian + Jacobian)
def G2.add(p: G2, q: G2) -> G2:
  match p q:
    case G2{x1, y1, z1} G2{x2, y2, z2}:
      +z1z1 = Q.Fq2.sqr(z1)
      +z2z2 = Q.Fq2.sqr(z2)
      +u1 = Q.Fq2.mul(x1, z2z2)
      +u2 = Q.Fq2.mul(x2, z1z1)
      +s1 = Q.Fq2.mul(Q.Fq2.mul(y1, z2), z2z2)
      +s2 = Q.Fq2.mul(Q.Fq2.mul(y2, z1), z1z1)
      +h = Q.Fq2.sub(u2, u1)
      +hh = Q.Fq2.add(h, h)
      +i = Q.Fq2.sqr(hh)
      +j = Q.Fq2.mul(h, i)
      +rr = Q.Fq2.sub(s2, s1)
      +r = Q.Fq2.add(rr, rr)
      +v = Q.Fq2.mul(u1, i)
      +x3 = Q.Fq2.sub(Q.Fq2.sub(Q.Fq2.sqr(r), j), Q.Fq2.add(v, v))
      +s1j = Q.Fq2.mul(s1, j)
      +y3 = Q.Fq2.sub(Q.Fq2.mul(r, Q.Fq2.sub(v, x3)), Q.Fq2.add(s1j, s1j))
      +z3 = Q.Fq2.mul(Q.Fq2.sub(Q.Fq2.sub(Q.Fq2.sqr(Q.Fq2.add(z1, z2)), z1z1), z2z2), h)
      G2.add.fin(U32.is_eq(Q.Fq2.is_zero(z1), 1), U32.is_eq(Q.Fq2.is_zero(z2), 1), U32.is_eq(Q.Fq2.is_zero(h), 1), U32.is_eq(Q.Fq2.is_zero(rr), 1), G2{x1, y1, z1}, G2{x2, y2, z2}, G2{x3, y3, z3})

def G2.add_mixed.fin(p_inf: Bool, q_inf: Bool, h_zero: Bool, r_zero: Bool, p: G2, q: G2Aff, gen: G2) -> G2:
