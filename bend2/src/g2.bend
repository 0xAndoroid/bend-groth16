def G2.mul_scalar.step(bit: Bool, d: G2, p: G2) -> G2:
  match bit:
    case True{}:
      G2.add(d, p)
    case False{}:
      d

def G2.mul_scalar.go(i: Nat, acc: G2, +p: G2, +k: R.Fr) -> G2:
  match i:
    case 0n:
      acc
    case 1n++j:
      G2.mul_scalar.go(j, G2.mul_scalar.step(U32.is_eq(R.Fr.bits_window(k, j, 1n), 1), G2.double(acc), p), p, k)

