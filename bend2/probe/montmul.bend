def Fr.lo(x: Fr) -> U32:
  match x:
    case Fr{l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15}:
      l0

def Fr.show(x: Fr) -> String:
  match x:
    case Fr{l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15}:
      U32.show(l0) ++ "," ++ U32.show(l1) ++ "," ++ U32.show(l2) ++ "," ++ U32.show(l3) ++ "," ++ U32.show(l4) ++ "," ++ U32.show(l5) ++ "," ++ U32.show(l6) ++ "," ++ U32.show(l7) ++ "," ++ U32.show(l8) ++ "," ++ U32.show(l9) ++ "," ++ U32.show(l10) ++ "," ++ U32.show(l11) ++ "," ++ U32.show(l12) ++ "," ++ U32.show(l13) ++ "," ++ U32.show(l14) ++ "," ++ U32.show(l15)

# k chained products r <- mont(r, b)
def chain(k: Nat, r: Fr, +b: Fr) -> Fr:
  match k:
    case 0n:
      r
    case 1n+p:
      chain(p, mont(r, b), b)

# sequential leaf: n products on distinct inputs, xor-folded on limb 0
def leaf(n: Nat, +k: Nat, +i: U32, acc: U32) -> U32:
  match n:
    case 0n:
      acc
    case 1n+p:
      leaf(p, k, (i + 1 : U32), (acc .^. Fr.lo(chain(k, rnd((i * 2 : U32)), rnd((i * 2 + 1 : U32)))) : U32))

# fork tree: d levels, each leaf runs ln products
def tree(d: Nat, +ln: Nat, +k: Nat, +i: U32, +w: U32) -> U32:
  match d:
    case 0n:
      leaf(ln, k, i, 0)
    case 1n++p:
      +hw = (w >> 1n : U32)
      a b = tree(p, ln, k, i, hw) tree(p, ln, k, (i + hw : U32), hw)
      (a .^. b : U32)

def check(n: Nat, +i: U32) -> IO(Unit):
  match n:
    case 0n:
      IO.pure(Unit, Unit{})
    case 1n+p:
      do IO<Unit>:
        IO.print(U32.show(i) ++ " " ++ Fr.show(mont(rnd((i * 2 : U32)), rnd((i * 2 + 1 : U32)))))
        check(p, (i + 1 : U32))

def env_nat.parse(m: Maybe<&2, U32>, +dflt: Nat) -> Nat:
  match m:
    case Some{v}:
      U32.to_nat(v)
    case None{}:
      dflt

def env_nat.fin(r: Result<&1, &1, U32 & String, String>, +dflt: Nat) -> Nat:
  match r:
    case Done{s}:
      env_nat.parse(U32.read(s), dflt)
    case Fail{e}:
      dflt

def env_nat(name: String, +dflt: Nat) -> IO(Nat):
  do IO<Nat>:
    r : Result<&1, &1, U32 & String, String> <- IO.get_env(name)
    return env_nat.fin(r, dflt)

def run(g: Bool, +n: Nat, +fd: Nat, +k: Nat) -> U32:
  match g:
    case True{}:
      tree!(fd, Nat.pow(2n, Nat.sub(n, fd)), k, 0, U32.from_nat(Nat.pow(2n, n)))
    case False{}:
      tree(fd, Nat.pow(2n, Nat.sub(n, fd)), k, 0, U32.from_nat(Nat.pow(2n, n)))

def bench(+mode: String, +n: Nat, +fd: Nat, +k: Nat) -> IO(Unit):
  do IO<Unit>:
    t0 : Nat <- IO.now()
    x : U32 = run(String.eq(mode, "gpu"), n, fd, k)
    t1 : Nat <- IO.now()
    IO.print(mode ++ " N=" ++ Nat.show(n) ++ " FD=" ++ Nat.show(fd) ++ " K=" ++ Nat.show(k) ++ " xor=" ++ U32.show(x) ++ " ms=" ++ Nat.show(Nat.sub(t1, t0)))

def dispatch(is_check: Bool, +mode: String, +n: Nat, +fd: Nat, +k: Nat, +cnt: Nat) -> IO(Unit):
  match is_check:
    case True{}:
      check(cnt, 0)
    case False{}:
      bench(mode, n, fd, k)

def main() -> IO(Unit):
  do IO<Unit>:
    +mode : String <- IO.try(String, IO.get_env("MODE"))
    +n : Nat <- env_nat("N", 16n)
    +fd : Nat <- env_nat("FD", 10n)
    +k : Nat <- env_nat("K", 1n)
    +cnt : Nat <- env_nat("CHECK", 128n)
    dispatch(String.eq(mode, "check"), mode, n, fd, k, cnt)
